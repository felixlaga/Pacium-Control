diff --git a/scripts/prebuild.js b/scripts/prebuild.js
index 17f1d980e62e017d77058627a7a15c4c29f9470c..2737c251497ffe2afaeb4701d3d9614d4ec75db9 100644
--- a/scripts/prebuild.js	
+++ b/scripts/prebuild.js
@@ -17,9 +17,10 @@ const path = require('path');
 const PREBUILDS_ROOT = path.join(__dirname, '..', 'prebuilds');
 const PREBUILD_DIR = path.join(__dirname, '..', 'prebuilds', `${process.platform}-${process.arch}`);
 
-// Do not use prebuilds when npm_config_build_from_source is set
-if (process.env.npm_config_build_from_source === 'true') {
-  console.log('\x1b[33m> Removing prebuilds and rebuilding because npm_config_build_from_source is set\x1b[0m');
+// Pacium patches the macOS native source to close descriptor leaks, so the
+// bundled upstream binary must not bypass those fixes.
+if (process.env.npm_config_build_from_source === 'true' || process.platform === 'darwin') {
+  console.log('\x1b[33m> Removing prebuilds and rebuilding patched native sources\x1b[0m');
   fs.rmSync(PREBUILDS_ROOT, { recursive: true, force: true });
   process.exit(1);
 }
